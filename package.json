{
  "name": "wsk_restaurant",
  "version": "1.0.0",
  "description": "wsk_restaurant group project",
  "main": "server/src/index.js",
  "type": "module",
  "scripts": {
    "install:vite": "npm --prefix client install",
    "server": "node server/src/index.js",
    "dev": "nodemon server/src/index.js",
    "apidoc": "apidoc -i server/src/ -o docs/",
    "build": "npm --prefix client run build",
    "install-all": "npm install && npm run install:vite",
    "deploy:build": "npm run build && find ./public -mindepth 1 -not -name images -exec rm -rf {} + && cp -r client/dist/* public/",
    "api-test": "node tests/api-tests/api.test.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "apidoc": "^1.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4"
  }
}
